# ─── API Backend URL (Vite) ──────────────────────────────────────────
# Production: The full URL of your Django backend on Render
# Development: Leave empty to use the Vite dev proxy (→ localhost:8000)
#
# VITE_API_URL="https://your-app.onrender.com"
#
# Examples:
#   Production: VITE_API_URL="https://nl-nazmul-chowdhury.onrender.com"
#   Local dev:  (leave empty — Vite proxy handles it)

# ─── Stripe (Premium / Pro payments) ────────────────────────────────
# Get your publishable key from https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXX"

# The Stripe Price ID for the Pro plan (from Stripe Dashboard → Products)
VITE_STRIPE_PRICE_ID="price_XXXXXXXXXXXXXXXXXXXXXXXX"

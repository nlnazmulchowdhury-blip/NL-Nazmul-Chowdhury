# ─── Frontend Environment Variables ──────────────────────────────────────
#
# VITE_API_URL: Your Render backend API URL
# Set this to your deployed Django backend on Render, e.g.:
#   https://proconverterbd-api.onrender.com
#
# IMPORTANT: This MUST be set in Vercel Dashboard → Settings → Environment Variables
# Otherwise the frontend will call ITSELF for API data and fail with 500 errors.
#
VITE_API_URL=https://proconverterbd-api.onrender.com

# Stripe keys for Pro payments (optional, only if Stripe is configured)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxx
# VITE_STRIPE_PRICE_ID=price_xxxxxxxxxxxxxx

# ─── Django Core ──────────────────────────────────────────────────────
DJANGO_SECRET_KEY="django-insecure-change-me-to-a-random-secret-key"
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_DEBUG="True"                        # Set to "False" in production
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,.onrender.com,.vercel.app"
DJANGO_LOG_LEVEL="DEBUG"                   # DEBUG | INFO | WARNING | ERROR (production)

# ─── Database (PostgreSQL via Supabase) ───────────────────────────────
# Copy this from Supabase Dashboard → Settings → Database → Connection string
# Use the Transaction Pooler (port 6543) with ?pgbouncer=true
# Format: postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.abcdefghijklmnopqrst:your-supabase-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

DB_CONNECT_TIMEOUT="10"                   # Seconds before DB connection times out (default: 10, set lower for faster failures)

# If DATABASE_URL is missing or invalid, the app falls back to SQLite
# (data will NOT persist across Render deploys with SQLite)

# ─── CORS (Cross-Origin Resource Sharing) ────────────────────────────
# When CORS_ALLOW_ALL_ORIGINS is False, requests are only allowed from CORS_ALLOWED_ORIGINS
CORS_ALLOW_ALL_ORIGINS="False"             # "True" for development, "False" for production
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app"

# ─── CSRF Protection ─────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app"

# ─── Security / Cookies ──────────────────────────────────────────────
SESSION_COOKIE_SECURE="False"              # "True" in production (HTTPS only)
CSRF_COOKIE_SECURE="False"                 # "True" in production (HTTPS only)
SECURE_SSL_REDIRECT="False"                # "True" in production
